---
import { getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import { LuCalendar, LuChevronLeft, LuChevronRight, LuMapPin, LuSmartphone, LuX } from 'react-icons/lu';
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';

// Longest side of the image opened in the popup (Full HD)
const FULL_SIZE = 1920;

// Thumbnail width per layout, so the browser picks the smallest file that is sharp enough.
// The gallery is max 1104px wide (max-w-6xl minus px-6) and the script switches to
// 3 columns at a 900px gallery (948px window) and 2 columns at 560px (608px window).
// Wide photos (same ratio as the script's WIDE) can span two of the three columns.
const SMALL_SIZES = 'calc(100vw - 48px)';
const TWO_COLUMNS = '(min-width: 608px) calc((100vw - 52px) / 2)';
const PHOTO_SIZES = `(min-width: 1152px) 365px, (min-width: 948px) calc((100vw - 56px) / 3), ${TWO_COLUMNS}, ${SMALL_SIZES}`;
const WIDE_SIZES = `(min-width: 1152px) 734px, (min-width: 948px) calc((100vw - 56px) * 2 / 3 + 4px), ${TWO_COLUMNS}, ${SMALL_SIZES}`;

// Entries are named YYYY-MM-DD-slug; newest first
const entries = (await getCollection('gallery')).sort((a, b) => b.id.localeCompare(a.id));

const photos = await Promise.all(
  entries.map(async ({ id, data }) => {
    const { image, location, device, label } = data;
    const landscape = image.width >= image.height;
    const full = await getImage({
      src: image,
      format: 'webp',
      quality: 90,
      ...(landscape
        ? { width: Math.min(image.width, FULL_SIZE) }
        : { height: Math.min(image.height, FULL_SIZE) }),
    });
    const date = id.match(/^\d{4}-\d{2}-\d{2}/)?.[0];
    const day = date && new Date(date);
    return {
      image,
      full: full.src,
      alt: location ? `Photo taken in ${location}` : 'Photo by Batuhan Büber',
      date: day && day.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }),
      // The hover overlay is tight on space: "10 Aug 2022"
      shortDate: day && `${day.getUTCDate()} ${day.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' })} ${day.getUTCFullYear()}`,
      location,
      device,
      label,
    };
  })
);
---

<Layout title="Gallery">
  <section class="max-w-6xl mx-auto px-6 pt-40 min-[911px]:pt-32 pb-20">
    <div class="gallery" data-gallery>
      {photos.map((photo, index) => (
        <button
          type="button"
          class="photo"
          style={`aspect-ratio: ${photo.image.width} / ${photo.image.height}`}
          data-index={index}
          data-ratio={photo.image.width / photo.image.height}
          data-full={photo.full}
          data-alt={photo.alt}
          data-label={photo.label}
          data-date={photo.date}
          data-location={photo.location}
          data-device={photo.device}
        >
          <Image
            src={photo.image}
            alt={photo.alt}
            widths={[480, 960]}
            sizes={photo.image.width / photo.image.height >= 1.4 ? WIDE_SIZES : PHOTO_SIZES}
            loading={index < 6 ? 'eager' : 'lazy'}
          />
          <span class="overlay" aria-hidden="true">
            {photo.label && <span class="overlay-tag">{photo.label}</span>}
            <span class="overlay-meta">
              {photo.shortDate && <span><LuCalendar />{photo.shortDate}</span>}
              {photo.location && <span><LuMapPin />{photo.location}</span>}
              {photo.device && <span><LuSmartphone />{photo.device}</span>}
            </span>
          </span>
        </button>
      ))}
    </div>
  </section>

  <dialog class="lightbox" data-lightbox aria-label="Photo">
    <div class="lightbox-body">
      <button type="button" class="icon-button close" data-close aria-label="Close"><LuX /></button>
      <figure>
        <div class="stage">
          <button type="button" class="icon-button nav prev" data-prev aria-label="Previous photo"><LuChevronLeft /></button>
          <img data-full-image alt="" />
          <button type="button" class="icon-button nav next" data-next aria-label="Next photo"><LuChevronRight /></button>
        </div>
        <figcaption>
          <ul class="meta">
            <li data-field="date"><LuCalendar /><span></span></li>
            <li data-field="location"><LuMapPin /><span></span></li>
            <li data-field="device"><LuSmartphone /><span></span></li>
            <li data-field="label" class="tag"><span></span></li>
          </ul>
        </figcaption>
      </figure>
    </div>
  </dialog>
</Layout>

<script>
  // Gap between photos, in px; keep in sync with the CSS below
  const GAP = 4;
  // Photos at least this wide (width / height) span two columns
  const WIDE = 1.4;

  function columnCount(width: number) {
    if (width >= 900) return 3;
    if (width >= 560) return 2;
    return 1;
  }

  // Masonry: each photo goes to the shortest column, wide ones span two columns
  // when there are three. If a wide photo would leave a gap above it, the next
  // regular photo is placed first to fill that column; if there is none nearby,
  // the wide photo takes a single column instead.
  function layout(gallery: HTMLElement) {
    const width = gallery.clientWidth;
    if (!width || gallery.dataset.width === String(width)) return;
    gallery.dataset.width = String(width);

    const count = columnCount(width);
    const column = (width - GAP * (count - 1)) / count;
    const heights = Array<number>(count).fill(0);
    const maxGap = column * 0.05;
    const isWide = (photo: HTMLElement) => count >= 3 && Number(photo.dataset.ratio) >= WIDE;

    function place(photo: HTMLElement, span: number) {
      let start = 0;
      let top = Infinity;
      for (let i = 0; i + span <= count; i++) {
        const tops = heights.slice(i, i + span);
        const columnTop = Math.max(...tops);
        // A wide photo only goes where its two columns end at about the same height
        if (Math.min(...tops) < columnTop - maxGap) continue;
        if (columnTop < top) [start, top] = [i, columnTop];
      }
      const photoWidth = column * span + GAP * (span - 1);
      const photoHeight = photoWidth / Number(photo.dataset.ratio);
      Object.assign(photo.style, {
        left: `${start * (column + GAP)}px`,
        top: `${top}px`,
        width: `${photoWidth}px`,
        height: `${photoHeight}px`,
      });
      heights.fill(top + photoHeight + GAP, start, start + span);
    }

    // Uneven tops under the best pair of columns for a wide photo
    function wideGap() {
      let best = Infinity;
      for (let i = 0; i + 2 <= count; i++) best = Math.min(best, Math.abs(heights[i] - heights[i + 1]));
      return best;
    }

    const queue = [...gallery.querySelectorAll<HTMLElement>('.photo')].sort(
      (a, b) => Number(a.dataset.index) - Number(b.dataset.index)
    );
    while (queue.length) {
      if (!isWide(queue[0])) {
        place(queue.shift()!, 1);
      } else if (wideGap() <= maxGap) {
        place(queue.shift()!, 2);
      } else {
        const regular = queue.findIndex((photo) => !isWide(photo));
        if (regular > 0 && regular <= 3) place(queue.splice(regular, 1)[0], 1);
        else place(queue.shift()!, 1);
      }
    }

    gallery.style.height = `${Math.max(...heights) - GAP}px`;
    gallery.dataset.laidOut = '';
  }

  function setup() {
    const gallery = document.querySelector<HTMLElement>('[data-gallery]');
    const lightbox = document.querySelector<HTMLDialogElement>('[data-lightbox]');
    if (!gallery || !lightbox) return;

    layout(gallery);

    const image = lightbox.querySelector<HTMLImageElement>('[data-full-image]')!;
    const photos = [...gallery.querySelectorAll<HTMLElement>('.photo')];
    let current = 0;

    function show(index: number) {
      current = (index + photos.length) % photos.length;
      const { full, alt, ...data } = photos[current].dataset;
      image.src = full!;
      image.alt = alt!;

      for (const field of ['date', 'location', 'device', 'label'] as const) {
        const element = lightbox!.querySelector<HTMLElement>(`[data-field="${field}"]`)!;
        const value = data[field];
        element.hidden = !value;
        element.querySelector('span')!.textContent = value ?? '';
      }

      const single = photos.length < 2;
      lightbox!.querySelectorAll<HTMLElement>('.nav').forEach((button) => (button.hidden = single));
    }

    gallery.addEventListener('click', (event) => {
      const photo = (event.target as HTMLElement).closest<HTMLElement>('.photo');
      if (!photo) return;
      show(Number(photo.dataset.index));
      lightbox.showModal();
    });

    lightbox.querySelector('[data-prev]')!.addEventListener('click', () => show(current - 1));
    lightbox.querySelector('[data-next]')!.addEventListener('click', () => show(current + 1));
    lightbox.querySelector('[data-close]')!.addEventListener('click', () => lightbox.close());

    // Clicking outside the photo and its details closes the popup
    lightbox.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (!target.closest('img, figcaption, button')) lightbox.close();
    });

    lightbox.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    });

    lightbox.addEventListener('close', () => image.removeAttribute('src'));
  }

  document.addEventListener('astro:page-load', setup);
  window.addEventListener('resize', () => {
    const gallery = document.querySelector<HTMLElement>('[data-gallery]');
    if (gallery) layout(gallery);
  });
</script>

<style>
  /* Before the script runs, photos simply stack */
  .gallery {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .gallery[data-laid-out] {
    display: block;
    position: relative;
  }

  .gallery[data-laid-out] .photo {
    position: absolute;
  }

  .photo {
    display: block;
    position: relative;
    padding: 0;
    overflow: hidden;
    border: none;
    background-color: var(--color-bg-secondary);
    cursor: zoom-in;
  }

  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    transition: transform 0.4s ease;
  }

  .photo:hover img {
    transform: scale(1.03);
  }

  .photo:focus-visible {
    outline: 2px solid var(--color-text-primary);
    outline-offset: 2px;
  }

  /* Details on hover; sits on the photo, so it stays light in both themes */
  .overlay {
    display: none;
  }

  @media (hover: hover) {
    .overlay {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      align-items: flex-start;
      padding: 0.875rem;
      color: #fff;
      text-align: left;
      letter-spacing: -0.02em;
      background: linear-gradient(to top, rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0.2) 45%, transparent 70%);
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .photo:hover .overlay,
    .photo:focus-visible .overlay {
      opacity: 1;
    }

    .overlay-tag {
      align-self: flex-end;
      padding: 0.25rem 0.625rem;
      font-size: 0.75rem;
      font-weight: 500;
      background-color: rgba(0, 0, 0, 0.45);
      backdrop-filter: blur(6px);
    }

    .overlay-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
      margin-top: auto;
      font-size: 0.8125rem;
      transform: translateY(0.5rem);
      transition: transform 0.3s ease;
    }

    .photo:hover .overlay-meta,
    .photo:focus-visible .overlay-meta {
      transform: translateY(0);
    }

    .overlay-meta span {
      display: flex;
      align-items: center;
      gap: 0.375rem;
    }

    /* A long location wraps instead of running past the photo */
    .overlay-meta svg {
      flex-shrink: 0;
    }
  }

  /* Popup */
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100vh;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--color-text-primary);
  }

  .lightbox::backdrop {
    background-color: var(--color-bg-primary);
    opacity: 0.96;
  }

  .lightbox-body {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 4rem 1rem 1.5rem;
    box-sizing: border-box;
  }

  figure {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    max-width: 100%;
    max-height: 100%;
    margin: 0;
  }

  .stage {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 0;
    max-width: 100%;
  }

  [data-full-image] {
    display: block;
    min-width: 0;
    max-width: min(100%, 1920px);
    max-height: calc(100vh - 10rem);
    object-fit: contain;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.5rem 1.25rem;
    font-size: 0.875rem;
  }

  .meta li {
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .meta .tag {
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 500;
    background-color: var(--color-bg-secondary);
  }

  [hidden] {
    display: none !important;
  }

  .icon-button {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    background-color: var(--color-bg-primary);
    color: var(--color-text-primary);
    font-size: 1.25rem;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .icon-button:hover {
    border-color: var(--color-text-secondary);
  }

  .close {
    position: absolute;
    top: 1rem;
    right: 1rem;
  }

  /* On small screens the arrows sit over the photo */
  @media (max-width: 639px) {
    .stage {
      position: relative;
    }

    .nav {
      position: absolute;
      z-index: 1;
    }

    .prev {
      left: 0.5rem;
    }

    .next {
      right: 0.5rem;
    }
  }
</style>
