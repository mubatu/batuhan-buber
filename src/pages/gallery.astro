---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PhotoGallery, { type Photo } from '../components/PhotoGallery.astro';
import '../styles/global.css';

// Entries are named YYYY-MM-DD-slug; newest first
const entries = (await getCollection('gallery')).sort((a, b) => b.id.localeCompare(a.id));

const photos: Photo[] = entries.map(({ id, data }) => {
  const { image, location, device, label } = data;
  const date = id.match(/^\d{4}-\d{2}-\d{2}/)?.[0];
  const day = date && new Date(date);
  return {
    image,
    alt: location ? `Photo taken in ${location}` : 'Photo by Batuhan Büber',
    date: day && day.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }),
    // The hover overlay is tight on space: "10 Aug 2022"
    shortDate: day && `${day.getUTCDate()} ${day.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' })} ${day.getUTCFullYear()}`,
    location,
    device,
    label,
  };
});
---

<Layout title="Gallery">
  <section class="max-w-6xl mx-auto px-6 pt-40 min-[911px]:pt-32 pb-20">
    <PhotoGallery photos={photos} />
  </section>
</Layout>
