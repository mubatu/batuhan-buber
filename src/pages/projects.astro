---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { type Project, getProjects } from '../lib/projects';
import '../styles/global.css';

const projects = await getProjects();

// Featured projects take a full row; consecutive others share a two-column grid
const rows: (Project | Project[])[] = [];
for (const project of projects) {
  const last = rows.at(-1);
  if (project.data.featured) rows.push(project);
  else if (Array.isArray(last)) last.push(project);
  else rows.push([project]);
}
---

<Layout title="Projects">
  <section class="max-w-4xl mx-auto px-6 pt-40 min-[911px]:pt-32 pb-20 flex flex-col gap-6">
    {rows.map((row) =>
      Array.isArray(row) ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {row.map((project) => <ProjectCard project={project} />)}
        </div>
      ) : (
        <ProjectCard project={row} featured />
      )
    )}
  </section>
</Layout>
