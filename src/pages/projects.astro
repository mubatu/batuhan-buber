---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects } from '../lib/projects';
import '../styles/global.css';

const projects = await getProjects();
const featured = projects.filter((project) => project.data.featured);
const others = projects.filter((project) => !project.data.featured);
---

<Layout title="Projects">
  <section class="max-w-4xl mx-auto px-6 pt-40 pb-20 flex flex-col gap-6">
    {featured.map((project) => <ProjectCard project={project} featured />)}

    {others.length > 0 && (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {others.map((project) => <ProjectCard project={project} />)}
      </div>
    )}
  </section>
</Layout>
