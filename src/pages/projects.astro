---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="Projects">
  <main class="flex justify-start max-w-4xl mx-auto px-6 pt-40">
    <div class="flex flex-col">
      <h1 class="text-4xl mb-6" style="color: var(--color-text-primary)">
        Projects
      </h1>
      <p class="text-lg mb-4" style="color: var(--color-text-secondary)">
        Coming soon
      </p>
      <p
        class="max-w-2xl text-base leading-relaxed"
        style="color: var(--color-text-secondary)"
      >
        For now, you can see my projects on:
        <br />
        -
        <a
          href="https://www.linkedin.com/in/batuhanbuber/details/projects/"
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-4"
          style="color: var(--color-text-primary)"
          >Linkedin projects section</a
        >
        <br />
        -
        <a
          href="https://github.com/mubatu"
          target="_blank"
          rel="noopener noreferrer"
          class="underline underline-offset-4"
          style="color: var(--color-text-primary)"
          >my GitHub page</a
        >
      </p>
    </div>
  </main>
</Layout>
