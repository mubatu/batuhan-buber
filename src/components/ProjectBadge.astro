---
import { FaGithub } from 'react-icons/fa6';
import { LuPalette, LuWrench } from 'react-icons/lu';
import { type ProjectStatus } from '../lib/projects';

interface Props {
  status: ProjectStatus;
}

const { status } = Astro.props;
---

{status === 'live' && (
  <span class="badge badge--live"><span class="dot" aria-hidden="true"></span>Live</span>
)}
{status === 'design' && (
  <span class="badge"><LuPalette aria-hidden="true" />Design</span>
)}
{status === 'open-source' && (
  <span class="badge"><FaGithub aria-hidden="true" />Open source</span>
)}
{status === 'tools' && (
  <span class="badge"><LuWrench aria-hidden="true" />Tool</span>
)}

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.125rem 0.5rem;
    font-size: 0.75rem;
    border-radius: 9999px;
    color: var(--color-text-secondary);
    background-color: var(--color-bg-secondary);
  }

  .badge--live {
    color: var(--color-live-text);
    background-color: var(--color-live-bg);
  }

  .dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 9999px;
    background-color: currentColor;
  }
</style>
